# ─── CRM Database ────────────────────────────────────────────────────────────
CRM_DB_HOST=
CRM_DB_USER=
CRM_DB_PASSWORD=
CRM_DB_NAME=

# ─── Tracking Database ────────────────────────────────────────────────────────
TRACKING_DB_HOST=
TRACKING_DB_USER=
TRACKING_DB_PASSWORD=
TRACKING_DB_NAME=

# ─── Email (SMTP) for alert notifications ─────────────────────────────────────
# Put real values in .env.local (not committed). Without SMTP_HOST, alert
# emails are switched off and only dashboard notifications are shown.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set to false only if the mail server uses a self-signed certificate
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
