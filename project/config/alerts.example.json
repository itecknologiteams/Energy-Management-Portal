{
  "_readme": "Server-only alert settings. Copy to alerts.json (git-ignored) and edit. Recipients and limits per fleet are managed in the admin portal at /admin, not here. See project/ALERTS.md.",
  "timezone": "Asia/Karachi",
  "dbTimestampsAreLocalTime": true,
  "temperature": {
    "enabled": true,
    "defaultThresholdC": 90,
    "vehicleThresholdsC": {},
    "recoveryMarginC": 2
  },
  "monitor": {
    "enabled": true,
    "intervalMinutes": 5,
    "fleetIds": [],
    "maxReadingAgeMinutes": 30,
    "repeatEmailEveryMinutes": 60,
    "sendRecoveryEmail": true
  },
  "email": {
    "enabled": false,
    "from": "EMS Alerts <alerts@itecknologi.com>",
    "subjectPrefix": "[EMS Alert]",
    "recipients": {
      "_note": "Per-fleet recipients are set in /admin. 'default' is only for npm run alerts:test-email; it never receives fleet alerts unless defaultForFleetsWithoutRecipients is true.",
      "default": {
        "to": [
          "operations@itecknologi.com"
        ],
        "cc": []
      },
      "byFleet": {},
      "defaultForFleetsWithoutRecipients": false
    },
    "smtp": {
      "host": "smtp.office365.com",
      "port": 587,
      "secure": false,
      "auth": {
        "user": "alerts@itecknologi.com",
        "pass": ""
      },
      "tls": {
        "rejectUnauthorized": true
      },
      "connectionTimeoutMs": 15000
    }
  }
}
